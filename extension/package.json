{
  "name": "agent-tabs",
  "displayName": "Agent Tabs",
  "description": "Your terminal coding agents survive a VS Code restart, and every tab shows whether its agent is working, needs you, or is done.",
  "version": "0.3.0",
  "publisher": "swarupdonepudi",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/swarupdonepudi/agent-tabs"
  },
  "homepage": "https://github.com/swarupdonepudi/agent-tabs#readme",
  "bugs": "https://github.com/swarupdonepudi/agent-tabs/issues",
  "keywords": ["claude code", "coding agent", "terminal", "resume", "session restore", "ai"],
  "categories": ["Other", "AI"],
  "engines": {
    "vscode": "^1.93.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "agentTabs.newTab", "title": "New Agent Tab", "category": "Agent Tabs" },
      { "command": "agentTabs.resumeTab", "title": "New Tab from a Past Conversation", "category": "Agent Tabs" },
      { "command": "agentTabs.newTabInFolder", "title": "New Tab in Folder…", "category": "Agent Tabs" },
      { "command": "agentTabs.restore", "title": "Restore Saved Tabs", "category": "Agent Tabs" },
      { "command": "agentTabs.forgetAll", "title": "Forget All Saved Tabs in This Workspace", "category": "Agent Tabs" }
    ],
    "keybindings": [
      { "command": "agentTabs.newTab", "key": "ctrl+t", "mac": "cmd+t", "when": "terminalFocus" },
      { "command": "agentTabs.resumeTab", "key": "ctrl+shift+t", "mac": "cmd+shift+t", "when": "terminalFocus" },
      { "command": "agentTabs.newTabInFolder", "key": "ctrl+alt+t", "mac": "cmd+alt+t", "when": "terminalFocus" }
    ],
    "configuration": {
      "title": "Agent Tabs",
      "properties": {
        "agentTabs.defaultAgent": {
          "type": "string",
          "enum": ["claude"],
          "enumDescriptions": ["Claude Code"],
          "default": "claude",
          "description": "The coding agent a new tab starts."
        },
        "agentTabs.defaultFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where new tabs open: a workspace folder's name (e.g. `api`), an absolute path or a path starting with `~/`. Empty means the first workspace folder. The `AGENT_TABS_FOLDER` environment variable, when set, overrides this on one machine."
        },
        "agentTabs.extraArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "Extra arguments for every start and resume, e.g. `[\"--chrome\"]`."
        },
        "agentTabs.restoreOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Reopen the saved tabs, each in its own conversation, when the workspace opens."
        }
      }
    },
    "configurationDefaults": {
      "terminal.integrated.tabs.allowAgentCliTitle": false,
      "terminal.integrated.tabs.title": "${progress} ${sequence}",
      "terminal.integrated.tabs.description": "${task}${separator}${local}${separator}${host}"
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/extension.js --minify --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "vscode:prepublish": "npm run build",
    "package": "cp ../README.md ../LICENSE . && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.93.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
